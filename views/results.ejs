<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WayFind | Your Matches</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="results-page">

  <header class="navbar">
    <div class="logo">
      🌍 <span>WayFind</span>
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="/matcher">Find a Trip</a>
      <a href="/saved-trips">Saved Trips</a>
    </nav>
  </header>

  <main class="results-container">

    <section class="results-heading">
      <span class="hero-tag">✨ YOUR TRAVEL MATCHES</span>

      <h1>Destinations made <span>for you.</span></h1>

      <p>
        Based on your preferences, here are the destinations
        that match your travel style.
      </p>
    </section>

    <section class="preference-summary">

      <div class="summary-title">
        <span>🧭</span>
        <div>
          <h2>Your Travel Style</h2>
          <p>Here's what you told WayFind.</p>
        </div>
      </div>

      <div class="preference-tags">
        <span>💰 <%= preferences.budget %> budget</span>
        <span>📅 <%= preferences.duration %> days</span>
        <span>👥 <%= preferences.group %></span>
        <span>🌍 <%= preferences.type %></span>
        <span>🌤️ <%= preferences.climate %></span>
        <span>🎯 <%= preferences.activity %></span>
        <span>🚶 <%= preferences.pace %> pace</span>
      </div>

      <a href="/matcher" class="edit-preferences">
        ✏️ Change preferences
      </a>

    </section>

    <section class="results-grid">

      <% results.forEach((destination, index) => { %>

        <article class="destination-card">

          <div class="destination-top">

            <span class="rank-badge">
              #<%= index + 1 %>
            </span>

            <span class="match-badge">
              <%= destination.score %>% Match
            </span>

          </div>

          <div class="destination-icon">
            <% if (destination.type.includes("beach")) { %>
              🏝️
            <% } else if (destination.type.includes("mountains")) { %>
              🏔️
            <% } else if (destination.type.includes("heritage")) { %>
              🏛️
            <% } else if (destination.type.includes("nature")) { %>
              🌿
            <% } else { %>
              🏙️
            <% } %>
          </div>

          <div class="destination-info">
            <h2><%= destination.name %></h2>

            <p class="destination-state">
              📍 <%= destination.state %>
            </p>

            <div class="match-bar">
              <div
                class="match-progress"
                style="--match-width: <%= destination.score %>%;"
              </div>
            </div>

            <p class="match-description">
              This destination matches your travel preferences
              across budget, activities, climate and travel style.
            </p>

            <div class="destination-tags">

              <% destination.type.forEach((type) => { %>
                <span><%= type %></span>
              <% }); %>

            </div>

          </div>

        </article>

      <% }); %>

    </section>

    <section class="results-actions">

      <a href="/matcher" class="btn btn-primary">
        🔄 Try Another Match
      </a>

      <a href="/saved-trips" class="btn btn-secondary">
        💾 View Saved Trips
      </a>

    </section>

  </main>


  <footer class="footer">

    <p>
      WayFind · Find trips that match your style
      <p>Running commit: <%= commitId %></p>
    </p>

  </footer>

</body>
</html>