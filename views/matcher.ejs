<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WayFind | Find Your Trip</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="matcher-page">

  <header class="navbar">
    <div class="logo">
      🌍 <span>WayFind</span>
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="/matcher">Find a Trip</a>
      <a href="/saved-trips">Saved Trips</a>
    </nav>
  </header>

  <main class="matcher-container">

    <section class="matcher-heading">
      <span class="hero-tag">✨ LET'S FIND YOUR MATCH</span>

      <h1>What's your <span>travel style?</span></h1>

      <p>
        Tell us a little about your ideal trip and WayFind
        will discover destinations that match your preferences.
      </p>
    </section>

    <form action="/match" method="POST" class="matcher-form">

      <div class="form-section">
        <div class="form-section-title">
          <span>💰</span>
          <div>
            <h2>Your Trip</h2>
            <p>Start with the basics.</p>
          </div>
        </div>

        <div class="form-grid">

          <div class="form-group">
            <label for="budget">What's your budget?</label>

            <select id="budget" name="budget" required>
              <option value="" disabled selected>Select budget</option>
              <option value="low">💚 Low</option>
              <option value="medium">💛 Medium</option>
              <option value="high">💜 High</option>
            </select>
          </div>

          <div class="form-group">
            <label for="duration">How many days?</label>

            <select id="duration" name="duration" required>
              <option value="" disabled selected>Select duration</option>
              <option value="2">2 days</option>
              <option value="3">3 days</option>
              <option value="4">4 days</option>
              <option value="5">5 days</option>
              <option value="6">6 days</option>
              <option value="7">7 days</option>
            </select>
          </div>

          <div class="form-group">
            <label for="group">Who are you travelling with?</label>

            <select id="group" name="group" required>
              <option value="" disabled selected>Select group</option>
              <option value="family">👨‍👩‍👧 Family</option>
              <option value="friends">🧑‍🤝‍🧑 Friends</option>
              <option value="couple">💑 Couple</option>
            </select>
          </div>

        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">
          <span>🌈</span>
          <div>
            <h2>Your Preferences</h2>
            <p>What kind of place feels right for you?</p>
          </div>
        </div>

        <div class="form-grid">

          <div class="form-group">
            <label for="type">Destination type</label>

            <select id="type" name="type" required>
              <option value="" disabled selected>Choose a type</option>
              <option value="mountains">🏔️ Mountains</option>
              <option value="beach">🏝️ Beach</option>
              <option value="heritage">🏛️ Heritage</option>
              <option value="city">🏙️ City</option>
              <option value="nature">🌿 Nature</option>
            </select>
          </div>

          <div class="form-group">
            <label for="climate">Preferred climate</label>

            <select id="climate" name="climate" required>
              <option value="" disabled selected>Choose climate</option>
              <option value="cold">❄️ Cold</option>
              <option value="cool">🌤️ Cool</option>
              <option value="moderate">🌥️ Moderate</option>
              <option value="warm">☀️ Warm</option>
              <option value="dry">🏜️ Dry</option>
            </select>
          </div>

          <div class="form-group">
            <label for="activity">Favourite activity</label>

            <select id="activity" name="activity" required>
              <option value="" disabled selected>Choose activity</option>
              <option value="nature">🌿 Nature</option>
              <option value="sightseeing">📸 Sightseeing</option>
              <option value="adventure">🧗 Adventure</option>
              <option value="beach">🌊 Beach</option>
              <option value="water">🏄 Water activities</option>
              <option value="heritage">🏛️ Heritage</option>
              <option value="food">🍜 Food</option>
              <option value="relaxation">🧘 Relaxation</option>
            </select>
          </div>

          <div class="form-group">
            <label for="pace">Travel pace</label>

            <select id="pace" name="pace" required>
              <option value="" disabled selected>Choose pace</option>
              <option value="relaxed">🌿 Relaxed</option>
              <option value="moderate">🚶 Moderate</option>
              <option value="fast">⚡ Fast-paced</option>
            </select>
          </div>

        </div>
      </div>

      <div class="form-submit">
        <button type="submit" class="btn btn-primary matcher-button">
          Find My Perfect Match ✨
        </button>

        <p>We'll compare your preferences with our destinations.</p>
      </div>

    </form>

  </main>


  <footer class="footer">
    <p>WayFind · Made for curious travellers</p>
    <p>Running commit: <%= commitId %></p>
  </footer>

</body>
</html>