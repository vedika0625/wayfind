<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WayFind | Saved Trips</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="saved-page">

  <header class="navbar">
    <div class="logo">
      🌍 <span>WayFind</span>
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="/matcher">Find a Trip</a>
      <a href="/saved-trips">Saved Trips</a>
    </nav>
  </header>

  <main class="saved-container">

    <section class="saved-heading">
      <span class="hero-tag">💾 YOUR TRAVEL PLANS</span>

      <h1>Your saved <span>travel styles.</span></h1>

      <p>
        Keep track of the travel preferences you've explored with WayFind.
      </p>
    </section>

    <% if (profiles.length === 0) { %>

      <section class="empty-trips">

        <div class="empty-icon">🧳</div>

        <h2>No trips explored yet</h2>

        <p>
          Start by telling WayFind what kind of trip you're looking for.
          We'll find destinations that match your style.
        </p>

        <a href="/matcher" class="btn btn-primary">
          Find My Destination ✈️
        </a>

      </section>

    <% } else { %>

      <section class="saved-grid">

        <% profiles.forEach((profile, index) => { %>

          <article class="saved-card">

            <div class="saved-card-top">

              <span class="trip-number">
                Trip #<%= index + 1 %>
              </span>

              <span class="saved-icon">🧭</span>

            </div>

            <h2>
              <%= profile.type %> getaway
            </h2>

            <p class="saved-subtitle">
              <%= profile.duration %> day trip for <%= profile.group %>
            </p>

            <div class="saved-tags">

              <span>💰 <%= profile.budget %></span>
              <span>🌤️ <%= profile.climate %></span>
              <span>🎯 <%= profile.activity %></span>
              <span>🚶 <%= profile.pace %></span>

            </div>

            <div class="saved-card-footer">
              <span>🌍 WayFind Travel Profile</span>
            </div>

          </article>

        <% }); %>

      </section>

      <div class="saved-actions">

        <a href="/matcher" class="btn btn-primary">
          ✨ Create Another Trip
        </a>

        <a href="/" class="btn btn-secondary">
          Back to Home
        </a>

      </div>

    <% } %>

  </main>

  <footer class="footer">

    <p>
      WayFind · Find trips that match your style
      <p>Running commit: <%= commitId %></p>
    </p>

  </footer>

</body>
</html>