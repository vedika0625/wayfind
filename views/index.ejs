<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WayFind | Find Your Perfect Destination</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="home-page">

  <header class="navbar">
    <div class="logo">
      🌍 <span>WayFind</span>
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="/matcher">Find a Trip</a>
      <a href="/saved-trips">Saved Trips</a>
    </nav>
  </header>

  <main>

    <section class="hero">

      <div class="hero-content">
        <span class="hero-tag">✈️ PERSONALIZED TRAVEL DISCOVERY</span>

        <h1>
          Find a place that
          <span>feels like you.</span>
        </h1>

        <p>
          Tell WayFind how you like to travel and discover destinations
          that match your budget, interests, climate and travel style.
        </p>

        <div class="hero-buttons">
          <a href="/matcher" class="btn btn-primary">
            Find My Destination ✈️
          </a>

          <a href="/saved-trips" class="btn btn-secondary">
            View Saved Trips
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="travel-card card-one">
          🏔️
          <span>Mountains</span>
        </div>

        <div class="travel-card card-two">
          🏝️
          <span>Beaches</span>
        </div>

        <div class="travel-card card-three">
          🏛️
          <span>Heritage</span>
        </div>

        <div class="travel-card card-four">
          🌿
          <span>Nature</span>
        </div>

        <div class="globe">
          🌍
        </div>
      </div>

    </section>

    <section class="features">

      <div class="section-heading">
        <span>WHY WAYFIND?</span>
        <h2>Travel planning, made personal.</h2>
      </div>

      <div class="feature-grid">

        <div class="feature-card">
          <div class="feature-icon">🎯</div>
          <h3>Personalized Matches</h3>
          <p>
            Destinations are scored according to your travel preferences.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">💰</div>
          <h3>Budget Friendly</h3>
          <p>
            Find destinations that fit the budget you choose.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🌤️</div>
          <h3>Your Travel Style</h3>
          <p>
            Choose your climate, activities, pace and destination type.
          </p>
        </div>

      </div>

    </section>

  </main>


<footer class="footer">

    <p>
      WayFind · Find trips that match your style
      <p>Running commit: <%= commitId %></p>
    </p>

  </footer>

</body>
</html>